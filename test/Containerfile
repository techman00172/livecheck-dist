# Containerfile — isolated test environment for LiveCheck
# Builds a clean Arch base with everything LiveCheck needs, so the test
# harness can verify the manual install in total isolation (no fossilcrew,
# no swdai, no contamination from Terry's box).  Wipe-and-repeat: the
# container is discarded after each run.
#
# Build:  podman build -t livecheck-dist-test -f test/Containerfile .
# Run:    podman run --rm livecheck-dist-test /test-isolated.sh

FROM archlinux:latest

# Base tooling: python + tkinter (the console), sqlite3 (databases),
# git/curl (fetch tools), xvfb (headless GUI test), libxslt (the SVD->db
# build needs xsltproc).
RUN pacman -Sy --noconfirm --needed \
        python tk sqlite \
        base-devel git curl \
        xorg-server-xvfb \
        libxslt \
    && rm -rf /var/cache/pacman/pkg

# Helix (the editor the LSPs plug into) — latest release binary.
RUN curl -fsSL https://github.com/helix-editor/helix/releases/download/25.07.1/helix-25.07.1-x86_64-linux.tar.xz \
        -o /tmp/helix.tar.xz \
    && tar -xJf /tmp/helix.tar.xz -C /usr/local \
    && mv /usr/local/helix-25.07.1-x86_64-linux/hx /usr/local/bin/hx \
    || true

# The repo is mounted in at /test-src; the test script lives in the image.
ENV HOME=/root
WORKDIR /root

COPY test/test-isolated.sh /test-isolated.sh
RUN chmod +x /test-isolated.sh
CMD ["/test-isolated.sh"]
